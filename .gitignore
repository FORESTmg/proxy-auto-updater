# FOREST's Proxy Auto-updater — локальные данные и артефакты сборки
# (в репозитории НЕ должно быть личного: ни состояния, ни логов, ни конфига)

# рабочий конфиг (личный) — в репозитории только config.example.json
/config.json
config.json

# состояние и логи (по умолчанию пишутся в %LOCALAPPDATA%\ForestProxyUpdater,
# но на случай запуска с paths.root внутри проекта — исключаем)
/state/
/state
/logs/
/logs

# кэши серверов и прочее
*.log
*.pid
subscription_base64.txt
pool_cache.json
lastgood_servers.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# сборка
build/
dist/
build-console/
dist-console/
*.spec
packaging/build/
packaging/dist/

# Linux-пакеты: готовые артефакты и рабочие каталоги сборщиков
# (артефакты пересобираются: packaging-linux/build-all.sh)
packaging-linux/out/
packaging-linux/work/

# логи прогонов стенда linux/tests/run-matrix.sh
linux/tests/matrix-*/

# стендовые прогоны матрицы DE (docs/de-matrix/): в репозиторий идут только
# страницы отчётов и снимки экрана. Журналы, состояние и harness-скрипты стенда
# (Xvfb/openbox/xdotool, личные пути) остаются локально — они пересобираются.
/docs/de-matrix/*/logs/
/docs/de-matrix/*/root/
/docs/de-matrix/*/harness/

# секреты и локальные копии — в репозиторий не попадают никогда
.env
.env.*
*.pem
*.key
.backup-*
*.bak
*.orig

# тестовые пакеты прошлых версий: нужны только на стенде, не в дереве
test-packages/
baseline/

# редакторы / ОС
.idea/
.vscode/
Thumbs.db
desktop.ini
