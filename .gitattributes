# ── Переводы строк ─────────────────────────────────────────────────────────
# Причина файла: репозиторий собирается на Windows (git clone с core.autocrlf=true)
# и упаковывается в WSL. Скрипты установки с CRLF ломают `curl … | bash`:
#   bash: строка 30: $'\r': command not found
# Поэтому для всего, что уходит в пакеты, жёстко зафиксирован LF — независимо
# от настроек git и операционной системы.

* text=auto eol=lf

# Скрипты и служебные файлы пакетов: только LF (это исполняется в Linux).
*.sh        text eol=lf
*.install   text eol=lf
*.desktop   text eol=lf
*.desktop.in text eol=lf
postinst    text eol=lf
prerm       text eol=lf
postrm      text eol=lf
preinst     text eol=lf
PKGBUILD    text eol=lf
*.spec      text eol=lf
*.spec.in   text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.py        text eol=lf
*.qml       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.in        text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Бинарные артефакты: git их не трогает.
*.png       binary
*.ico       binary
*.exe       binary
*.zst       binary
*.gz        binary
*.deb       binary
*.rpm       binary
*.AppImage  binary
*.vhdx      binary
