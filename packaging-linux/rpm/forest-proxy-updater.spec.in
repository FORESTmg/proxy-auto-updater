# FOREST's Proxy Auto-updater — спецификация RPM (Fedora / RHEL / Rocky / Alma / openSUSE)
# Copyright (C) 2026 FOREST
# SPDX-License-Identifier: GPL-3.0-only
#
# Собирается скриптом packaging-linux/build-rpm.sh: он кладёт готовое дерево
# файлов в каталог источников rpmbuild (SOURCE/payload) — раскладку задаёт
# packaging-linux/lib/common.sh, одна на все форматы. Здесь только упаковка и
# скрипты rpm.
#
# Почему отключена автоматическая пост-обработка install (brp-strip и debuginfo):
# полезная нагрузка — уже собранный PyInstaller-onefile ELF, полосовать его не
# нужно и рискованно (можно испортить однофайловый архив).

%global __os_install_post %{nil}
%global debug_package %{nil}

Name:           forest-proxy-updater
Version:        @VERSION@
Release:        @RELEASE@
Summary:        @SUMMARY@
License:        GPL-3.0-only
URL:            @HOMEPAGE@
BuildArch:      x86_64
Requires:       curl
# Помощник интерфейса (forest-ui, Qt6) грузит плагин платформы xcb/wayland.
# Сам плагин ЕДЕТ В КОМПЛЕКТЕ (PySide6/Qt/plugins/platforms), а эти системные
# библиотеки объявлены по SONAME — так имя пакета не зависит от дистрибутива
# (Fedora: libxkbcommon-x11, xcb-util-cursor, xcb-util-wm, xcb-util-keysyms,
# xcb-util-image, xcb-util-renderutil, libxcb). Проверено: без них
# `QT_QPA_PLATFORM=xcb forest-ui` не стартует («libxkbcommon-x11.so.0: cannot
# open shared object file»).
Requires:       libxkbcommon-x11.so.0()(64bit)
Requires:       libxcb-cursor.so.0()(64bit)
Requires:       libxcb-icccm.so.4()(64bit)
Requires:       libxcb-image.so.0()(64bit)
Requires:       libxcb-keysyms.so.1()(64bit)
Requires:       libxcb-render-util.so.0()(64bit)
Requires:       libxcb-shape.so.0()(64bit)
Requires:       libxcb-xkb.so.1()(64bit)
# libGL/libEGL Qt грузит ДИНАМИЧЕСКИ (dlopen) для GL-интеграции xcb. Без них
# помощник работает (программная отрисовка), но объявляем — так GL точно есть.
Recommends:     libGL.so.1()(64bit)
Recommends:     libEGL.so.1()(64bit)

%description
Программа сама скачивает публичные списки прокси-серверов, проверяет их
(TCP-предфильтр, RTT, скорость, финальная проверка), поднимает ядро Xray на
локальном SOCKS5-порту (по умолчанию 127.0.0.1:10808) и следит за связью:
упавший сервер заменяется автоматически, пул обновляется по расписанию.

Ядро Xray и гео-базы (geoip.dat, geosite.dat) ВШИТЫ в бинарник: докладывать
ничего не нужно, Python не требуется. Пакет ставит системную службу systemd
(forest-proxy-updater.service), которая поднимается при загрузке без входа в
систему и без loginctl enable-linger.

Конфиг: /etc/forest-proxy-updater/config.json, состояние и логи:
/var/lib/forest-proxy-updater, документация: /usr/share/doc/forest-proxy-updater.

Помощник интерфейса (forest-ui, Qt6) рисует значок в трее, меню и уведомления.
Плагины платформ Qt (xcb/wayland) и библиотеки Qt едут В КОМПЛЕКТЕ; системные
библиотеки объявлены в Requires (libxkbcommon-x11, xcb-util-cursor, xcb-util-wm,
xcb-util-keysyms, xcb-util-image, xcb-util-renderutil, libxcb).

ОГРАНИЧЕНИЯ ПРОВЕРКИ (RU): Проверка пакета выполнялась в среде WSL (Linux внутри Windows), а не на установленной системе на реальном железе. Меню и уведомления в графическом интерфейсе протестированы логически, но НЕ проверены на живом рабочем столе — возможны ошибки. Если что-то не работает, сообщите в репозитории.

TESTING SCOPE (EN): Package testing was performed in WSL (Linux on Windows), not on a real installation on bare metal. The GUI menu and notifications are tested logically but have NOT been verified on a live desktop — issues are possible. If something does not work, please report it in the repository.

%prep

%build

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
cp -a %{_sourcedir}/payload/. %{buildroot}/

%files
# Каталоги объявлены явно (%dir): без этого rpm не считает их своими и
# оставляет пустые каталоги после удаления пакета.
%dir /usr/lib/forest-proxy-updater
%dir /etc/forest-proxy-updater
%dir /usr/share/doc/forest-proxy-updater
%dir /usr/share/licenses/forest-proxy-updater
/usr/lib/forest-proxy-updater/forest-proxy-updater
/usr/bin/forest-proxy-updater
/usr/lib/forest-proxy-updater/forest-ui
/usr/bin/forest-ui
# Уборка панели от старого способа показа значка (виджет-плазмоид и закреплённый
# ярлык). Запускается от пользователя, root не нужен.
/usr/lib/forest-proxy-updater/forest-clean-desktop
/usr/bin/forest-clean-desktop
/usr/share/applications/forest-proxy-updater.desktop
/usr/share/applications/forest-proxy-updater-ui.desktop
/usr/share/icons/hicolor/256x256/apps/forest-proxy-updater.png
# Плазмоида в пакете БОЛЬШЕ НЕТ (правый клик по виджету панели забирает панель),
# и служебного ярлыка меню-попапа тоже — перечислять их в %files нельзя:
# rpmbuild падает с «File not found» ещё до записи пакета.
/usr/lib/systemd/system/forest-proxy-updater.service
/usr/lib/systemd/system/forest-proxy-updater-refresh.service
/usr/lib/systemd/system/forest-proxy-updater.timer
%config(noreplace) /etc/forest-proxy-updater/config.json
/usr/share/doc/forest-proxy-updater/README.md
/usr/share/doc/forest-proxy-updater/INSTALL.md
/usr/share/doc/forest-proxy-updater/INSTALL.ru.md
/usr/share/doc/forest-proxy-updater/TERMS.md
/usr/share/doc/forest-proxy-updater/TERMS.ru.md
/usr/share/doc/forest-proxy-updater/PACKAGE-README.md
/usr/share/doc/forest-proxy-updater/copyright
/usr/share/doc/forest-proxy-updater/COPYING
/usr/share/licenses/forest-proxy-updater/COPYING

%post
# ── ЧЕСТНАЯ ОСТАНОВКА СТАРОГО ЗНАЧКА ─────────────────────────────────────────
# upgrade НЕ снимает процессы прежней версии, а `forest-ui --stop` пишет флаг в
# каталог состояния ТОГО, кто его вызвал: у службы он другой, и флага она не
# видит (на живой машине 1.3.5 так остались ТРИ копии помощника и три значка).
# Здесь процесс снимается по ФАКТУ: pkill -f по ПОЛНОМУ пути (у копий разные
# аргументы, поэтому -x по имени не подходит), ожидание завершения и, если
# процесс не ушёл, SIGKILL. Дополнительно — проход по /proc по факту
# исполняемого файла: так снимаются копии, запущенные не из /usr/lib.
# Та же логика, что в packaging-linux/deb/postinst и arch/*.install.
_forest_ui_pids() {
    for d in /proc/[0-9]*; do
        exe=$(readlink "$d/exe" 2>/dev/null) || continue
        # Пакет уже заменил файл на новый (rpm распаковывает ДО %post), и ядро
        # показывает старый inode как «.../forest-ui (deleted)». Без этой строки
        # проход по /proc не находил ни одной живой копии — ровно в том
        # сценарии обновления, ради которого он и написан.
        exe=${exe% (deleted)}
        case "$exe" in
            */forest-ui|*/forest-ui.exe) echo "${d#/proc/}" ;;
        esac
    done
}

_forest_stop_old_ui() {
    pat='/usr/lib/forest-proxy-updater/forest-ui'
    before=$(_forest_ui_pids | tr '\n' ' ')
    # 1) по полному пути в командной строке — основной способ
    if command -v pgrep >/dev/null 2>&1; then
        if pgrep -f "$pat" >/dev/null 2>&1; then
            pkill -TERM -f "$pat" >/dev/null 2>&1 || true
        fi
    fi
    # 2) по факту исполняемого файла — копии с другим путём и аргументами
    for pid in $(_forest_ui_pids); do
        kill -TERM "$pid" 2>/dev/null || true
    done
    # 3) ждём до 6 с, затем SIGKILL тем, кто не ушёл
    i=0
    while [ "$i" -lt 60 ] && [ -n "$(_forest_ui_pids)" ]; do
        sleep 0.1
        i=$((i + 1))
    done
    if [ -n "$(_forest_ui_pids)" ]; then
        if command -v pkill >/dev/null 2>&1; then
            pkill -KILL -f "$pat" >/dev/null 2>&1 || true
        fi
        for pid in $(_forest_ui_pids); do
            kill -KILL "$pid" 2>/dev/null || true
        done
        sleep 0.3
    fi
    left=$(_forest_ui_pids | tr '\n' ' ')
    if [ -n "$before" ]; then
        echo "forest-proxy-updater: старый значок остановлен (было pid: $before; осталось: ${left:-нет})"
    else
        echo "forest-proxy-updater: старый значок не был запущен"
    fi
    rm -f /var/lib/forest-proxy-updater/state/forest-proxy-updater/ui_stop.flag 2>/dev/null || true
}

# Каталог состояния нужен и вне systemd (ручные запуски).
mkdir -p /var/lib/forest-proxy-updater
chmod 0755 /var/lib/forest-proxy-updater
# ДО запуска службы: снять ВСЕ живые копии помощника (иначе новая поднимется
# рядом со старой, и значков станет больше, а не один).
_forest_stop_old_ui
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl enable --now forest-proxy-updater.service >/dev/null 2>&1; then
    # ОБНОВЛЕНИЕ ИДУЩЕЙ СЛУЖБЫ: enable --now не перезапускает уже работающий
    # юнит, поэтому после установки продолжал бы работать СТАРЫЙ код (до
    # перезагрузки). Явный restart обязателен.
    systemctl restart forest-proxy-updater.service >/dev/null 2>&1 || true
    echo "forest-proxy-updater: служба включена и запущена (код обновлён)"
  else
    echo "forest-proxy-updater: службу запустить не удалось, смотрите:"
    echo "  journalctl -u forest-proxy-updater.service -n 50 --no-pager"
  fi
else
  echo "forest-proxy-updater: systemd не используется — автозапуск не настроен."
fi
echo "forest-proxy-updater: программа даёт доступ ко всем сайтам, включая заблокированные."
echo "  Ответственность за соблюдение законов своей юрисдикции лежит на пользователе."
echo "  Условия использования: /usr/share/doc/forest-proxy-updater/TERMS.ru.md (English: TERMS.md)."

%preun
if [ "$1" = "0" ]; then
  if [ -d /run/systemd/system ]; then
    systemctl disable --now forest-proxy-updater.service >/dev/null 2>&1 || true
    systemctl disable --now forest-proxy-updater.timer   >/dev/null 2>&1 || true
  fi
fi

%postun
[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = "0" ]; then
  rm -rf /var/lib/forest-proxy-updater
fi

%changelog
