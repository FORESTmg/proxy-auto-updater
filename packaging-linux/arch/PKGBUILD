# Maintainer: FOREST <forest@example.invalid>
# FOREST's Proxy Auto-updater — PKGBUILD для Arch Linux / Manjaro / EndeavourOS.
# Copyright (C) 2026 FOREST
# SPDX-License-Identifier: GPL-3.0-only
#
# Собирается не из сети: `source` — ЛОКАЛЬНЫЕ файлы, которые рядом с этим
# PKGBUILD раскладывает `packaging-linux/build-arch.sh` (готовый ELF со вшитым
# ядром Xray, отрендеренные юниты systemd, конфиг по умолчанию, документация).
# Тот же набор файлов попадает и в готовый .pkg.tar.zst, поэтому содержимое
# пакетов .deb / .rpm / Arch не может разъехаться.
#
#   cd packaging-linux/arch
#   makepkg -si          # никогда от root: makepkg это запрещает
#
# Контрольные суммы: в репозитории они 'SKIP' (файлы — локальные артефакты
# сборки, их хеши меняются от релиза к релизу). build-arch.sh дописывает в конец
# рабочей копии PKGBUILD реальные хеши (`makepkg -g`); ручную сборку можно вести
# и без них: makepkg -g >> PKGBUILD.

pkgname=forest-proxy-updater
pkgver=1.0.1
pkgrel=1
# Оговорка о проверке (та же формулировка, что в описаниях .deb/.rpm и в
# сообщении установочного скрипта):
#   ОГРАНИЧЕНИЯ ПРОВЕРКИ: Проверка пакета выполнялась в среде WSL (Linux внутри Windows), а не на установленной системе на реальном железе. Меню и уведомления в графическом интерфейсе протестированы логически, но НЕ проверены на живом рабочем столе — возможны ошибки. Если что-то не работает, сообщите в репозитории.
#   TESTING SCOPE: Package testing was performed in WSL (Linux on Windows), not on a real installation on bare metal. The GUI menu and notifications are tested logically but have NOT been verified on a live desktop — issues are possible. If something does not work, please report it in the repository.
pkgdesc="Auto-updating proxy supervisor built on top of the Xray core (core and geo bases bundled); GUI menu/notifications tested only in WSL, not on a live desktop"
arch=('x86_64')
url="https://github.com/FORESTmg/proxy-auto-updater"
license=('GPL-3.0-only')
# Помощник интерфейса (forest-ui, Qt6) грузит плагин платформы xcb/wayland; сам
# плагин едет в комплекте, а это — системные библиотеки для него. Имена и
# sonames проверены по ЖИВЫМ пакетам Arch (`extra`, 17.10.2026): libxcb даёт
# libxcb-shape.so.0 и libxcb-xkb.so.1, xcb-util-wm — libxcb-icccm.so.4,
# xcb-util-keysyms — libxcb-keysyms.so.1, xcb-util-image — libxcb-image.so.0,
# xcb-util-renderutil — libxcb-render-util.so.0, xcb-util-cursor —
# libxcb-cursor.so.0, libxkbcommon-x11 — libxkbcommon-x11.so.0.
depends=('bash'
         'curl'
         'hicolor-icon-theme'
         'libxkbcommon-x11'
         'xcb-util-cursor'
         'xcb-util-wm'
         'xcb-util-image'
         'xcb-util-keysyms'
         'xcb-util-renderutil'
         'libxcb')
# bash — .install-скрипты PKGBUILD и /usr/bin/forest-clean-desktop (#!/bin/bash);
# hicolor-icon-theme — значок ставится в /usr/share/icons/hicolor, без базовой
# темы hicolor панель и меню приложений его не находят (это находил namcap).
# libGL/libEGL нужны GL-интеграции xcb (Qt грузит их динамически): без драйвера
# помощник рисует программно, но с ним — как на обычном рабочем столе.
# ВАЖНО: без libglvnd/libEGL плагин xcb не загружается вовсе, Qt «недоступен»,
# и помощник честно выходит с кодом 3 («Qt недоступен») — интерфейса не будет,
# сама программа работает. Поэтому зависимость объявлена в optdepends.
optdepends=('libglvnd: GL/EGL для GL-интеграции xcb (иначе помощник выйдет с кодом 3 «Qt недоступен» и значка не будет)'
            'mesa: программный GL-драйвер (llvmpipe) для машин без видеодрайвера'
            'xorg-xwayland: значок в стиле трея на Wayland-сеансе (своё X11-окно ставится по координатам; без Xwayland остаётся значок лотка, и правый клик по нему в Plasma открывает меню лотка)')
install=forest-proxy-updater.install
options=('!strip' '!emptydirs' '!debug')

# /etc/.../config.json намеренно НЕ в backup=(): пакет всегда приносит рабочий
# конфиг по умолчанию, а .pacsave после удаления был бы мусором. Пользовательские
# правки имеет смысл хранить копией рядом (config.json.local).

source=('forest-proxy-updater'
        'forest-proxy-updater.service'
        'forest-proxy-updater-refresh.service'
        'forest-proxy-updater.timer'
        'config.json'
        'README.md'
        'INSTALL.md'
        'INSTALL.ru.md'
        'PACKAGE-README.md'
        'copyright'
        'COPYING'
        'TERMS.md'
        'TERMS.ru.md'
        'forest-proxy-updater.install'
        'forest-ui'
        'forest-proxy-updater.desktop'
        'forest-proxy-updater-ui.desktop'
        'forest-proxy-updater.png'
        'forest-clean-desktop')

sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP'
            'SKIP')

package() {
  # Программа: PyInstaller-onefile ELF, ядро xray и гео-базы внутри.
  install -Dm755 "$srcdir/forest-proxy-updater" \
      "$pkgdir/usr/lib/$pkgname/$pkgname"
  install -d "$pkgdir/usr/bin"
  ln -sf "/usr/lib/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"

  # Системная служба (не systemd --user): работает без входа в систему.
  install -Dm644 "$srcdir/forest-proxy-updater.service" \
      "$pkgdir/usr/lib/systemd/system/forest-proxy-updater.service"
  install -Dm644 "$srcdir/forest-proxy-updater-refresh.service" \
      "$pkgdir/usr/lib/systemd/system/forest-proxy-updater-refresh.service"
  install -Dm644 "$srcdir/forest-proxy-updater.timer" \
      "$pkgdir/usr/lib/systemd/system/forest-proxy-updater.timer"

  # Конфиг по умолчанию
  install -Dm644 "$srcdir/config.json" \
      "$pkgdir/etc/$pkgname/config.json"

  # Документация и лицензия
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/INSTALL.md" "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
  install -Dm644 "$srcdir/INSTALL.ru.md" "$pkgdir/usr/share/doc/$pkgname/INSTALL.ru.md"
  install -Dm644 "$srcdir/PACKAGE-README.md" "$pkgdir/usr/share/doc/$pkgname/PACKAGE-README.md"
  install -Dm644 "$srcdir/copyright" "$pkgdir/usr/share/doc/$pkgname/copyright"
  # COPYING — и в doc, и в licenses: первый путь ждут проверки матрицы и
  # пользователь (D3 из отчёта пакетов 1.3.8 — в Arch-пакете его не было),
  # второй — обычная практика Arch (licenses пакета).
  install -Dm644 "$srcdir/COPYING" "$pkgdir/usr/share/doc/$pkgname/COPYING"
  install -Dm644 "$srcdir/TERMS.md" "$pkgdir/usr/share/doc/$pkgname/TERMS.md"
  install -Dm644 "$srcdir/TERMS.ru.md" "$pkgdir/usr/share/doc/$pkgname/TERMS.ru.md"
  install -Dm644 "$srcdir/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"

  # Помощник интерфейса (Qt): значок в трее, меню и уведомления. Отдельный файл,
  # ядром не управляет. Программа ищет его рядом с собой (src/ui_helper.py).
  install -Dm755 "$srcdir/forest-ui" \
      "$pkgdir/usr/lib/$pkgname/forest-ui"
  install -d "$pkgdir/usr/bin"
  ln -sf "/usr/lib/$pkgname/forest-ui" "$pkgdir/usr/bin/forest-ui"

  # Ярлыки в меню приложений и значок (нужен и значку, и уведомлениям).
  # Ярлык ПОМОЩНИКА скрыт (NoDisplay=true): значок программы один, он
  # поднимается сам при входе в сеанс — второго значка в меню быть не должно.
  install -Dm644 "$srcdir/forest-proxy-updater.desktop" \
      "$pkgdir/usr/share/applications/forest-proxy-updater.desktop"
  install -Dm644 "$srcdir/forest-proxy-updater-ui.desktop" \
      "$pkgdir/usr/share/applications/forest-proxy-updater-ui.desktop"
  install -Dm644 "$srcdir/forest-proxy-updater.png" \
      "$pkgdir/usr/share/icons/hicolor/256x256/apps/forest-proxy-updater.png"

  # АВТОЗАПУСКА у значка нет: его поднимает САМА программа в сеансе
  # пользователя (watch.py -> ui_helper.ensure -> запуск от имени пользователя
  # сеанса с его DISPLAY/WAYLAND_DISPLAY). Так значок появляется и при запуске
  # программы, и при входе в сеанс — и он ОДИН (второго ярлыка в меню нет).

  # Уборка панели от СТАРОГО способа (виджет-плазмоид + закреплённый ярлык).
  # Запускается от пользователя: root не нужен, конфиг панели его.
  install -Dm755 "$srcdir/forest-clean-desktop" \
      "$pkgdir/usr/lib/$pkgname/forest-clean-desktop"
  install -d "$pkgdir/usr/bin"
  ln -sf "/usr/lib/$pkgname/forest-clean-desktop" \
      "$pkgdir/usr/bin/forest-clean-desktop"

  # ПЛАЗМОИДА В ПАКЕТЕ НЕТ: правый клик по виджету панели Plasma всегда забирает
  # панель («Настроить виджет / Режим редактирования / Удалить виджет»), и
  # никакой плазмоид этого не обойдёт. Значок — своё окно программы в стиле
  # трея (src/tray_popup.py). Остатки старой установки снимает .install.
}
