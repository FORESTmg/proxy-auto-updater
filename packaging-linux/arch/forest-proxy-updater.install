# FOREST's Proxy Auto-updater — install-скрипт pacman (Arch Linux).
# Copyright (C) 2026 FOREST
# SPDX-License-Identifier: GPL-3.0-only
#
# Ставит/снимает системную службу. Каталог состояния (/var/lib/forest-proxy-updater)
# нужен и вне systemd — при ручном запуске программы.

# ── ЧЕСТНАЯ ОСТАНОВКА СТАРОГО ЗНАЧКА ─────────────────────────────────────────
# post_upgrade печатал «значок один», а старые процессы оставались жить: на
# живой машине 1.3.5 после установки работали ТРИ копии помощника (273433/…,
# 342585/…, 343273/…) и в трее было три значка. Причина: остановка шла через
# `forest-ui --stop`, а он писал файл-флаг в каталог состояния ТОГО, кто его
# вызвал; служба запускает помощника с другим каталогом состояния — флага он не
# видел. Здесь процесс снимается по ФАКТУ: pkill -f по ПОЛНОМУ пути (у копий
# разные аргументы, поэтому -x по имени не подходит), ожидание завершения и,
# если процесс не ушёл, SIGKILL. Дополнительно — проход по /proc по факту
# исполняемого файла: так снимаются копии, запущенные не из /usr/lib.
_forest_ui_pids() {
    for d in /proc/[0-9]*; do
        exe=$(readlink "$d/exe" 2>/dev/null) || continue
        # Пакет уже заменил файл на новый (pacman распаковывает ДО post_upgrade),
        # и ядро показывает старый inode как «.../forest-ui (deleted)». Без этой
        # строки проход по /proc не находил ни одной живой копии — ровно в том
        # сценарии обновления, ради которого он и написан.
        exe=${exe% (deleted)}
        case "$exe" in
            */forest-ui|*/forest-ui.exe) echo "${d#/proc/}" ;;
        esac
    done
}

_forest_stop_old_ui() {
    pat='/usr/lib/forest-proxy-updater/forest-ui'
    before=$(_forest_ui_pids | tr '\n' ' ')
    # 1) по полному пути в командной строке — основной способ
    if command -v pgrep >/dev/null 2>&1; then
        if pgrep -f "$pat" >/dev/null 2>&1; then
            pkill -TERM -f "$pat" >/dev/null 2>&1 || true
        fi
    fi
    # 2) по факту исполняемого файла — копии с другим путём и аргументами
    for pid in $(_forest_ui_pids); do
        kill -TERM "$pid" 2>/dev/null || true
    done
    # 3) ждём до 6 с, затем SIGKILL тем, кто не ушёл
    i=0
    while [ "$i" -lt 60 ] && [ -n "$(_forest_ui_pids)" ]; do
        sleep 0.1
        i=$((i + 1))
    done
    if [ -n "$(_forest_ui_pids)" ]; then
        if command -v pkill >/dev/null 2>&1; then
            pkill -KILL -f "$pat" >/dev/null 2>&1 || true
        fi
        for pid in $(_forest_ui_pids); do
            kill -KILL "$pid" 2>/dev/null || true
        done
        sleep 0.3
    fi
    left=$(_forest_ui_pids | tr '\n' ' ')
    if [ -n "$before" ]; then
        echo "forest-proxy-updater: старый значок остановлен (было pid: $before; осталось: ${left:-нет})"
    else
        echo "forest-proxy-updater: старый значок не был запущен"
    fi
    # флаг остановки от прежних сборок больше не нужен
    rm -f /var/lib/forest-proxy-updater/state/forest-proxy-updater/ui_stop.flag \
          2>/dev/null || true
}

post_install() {
  mkdir -p /var/lib/forest-proxy-updater
  chmod 0755 /var/lib/forest-proxy-updater
  # ДО запуска службы: снять ВСЕ живые копии помощника (иначе новая поднимется
  # рядом со старой, и значков станет больше, а не один).
  _forest_stop_old_ui
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if systemctl enable --now forest-proxy-updater.service >/dev/null 2>&1; then
      # ОБНОВЛЕНИЕ ИДУЩЕЙ СЛУЖБЫ: enable --now НЕ перезапускает уже работающий
      # юнит, поэтому после установки продолжал работать СТАРЫЙ код (до
      # перезагрузки). Явный restart обязателен: помощник уже снят выше, новый
      # поднимется уже новым супервизором.
      systemctl restart forest-proxy-updater.service >/dev/null 2>&1 || true
      echo "forest-proxy-updater: служба включена и запущена (код обновлён)"
    else
      echo "forest-proxy-updater: службу запустить не удалось, смотрите:"
      echo "  journalctl -u forest-proxy-updater.service -n 50 --no-pager"
    fi
  else
    echo "forest-proxy-updater: systemd не используется — автозапуск не настроен."
    echo "  Ручной запуск: forest-proxy-updater --run"
  fi
  echo "forest-proxy-updater: программа даёт доступ ко всем сайтам, включая заблокированные."
  echo "  Ответственность за соблюдение законов своей юрисдикции лежит на пользователе."
  echo "  Условия использования: /usr/share/doc/forest-proxy-updater/TERMS.ru.md (English: TERMS.md)."
  echo
  echo "ОГРАНИЧЕНИЯ ПРОВЕРКИ: Проверка пакета выполнялась в среде WSL (Linux внутри Windows), а не на установленной системе на реальном железе. Меню и уведомления в графическом интерфейсе протестированы логически, но НЕ проверены на живом рабочем столе — возможны ошибки. Если что-то не работает, сообщите в репозитории."
  echo "TESTING SCOPE: Package testing was performed in WSL (Linux on Windows), not on a real installation on bare metal. The GUI menu and notifications are tested logically but have NOT been verified on a live desktop — issues are possible. If something does not work, please report it in the repository."
}

post_upgrade() {
  # ── убираем ОСТАТКИ старого способа показа значка ──
  # 1) виджет-плазмоид: правый клик по виджету панели всегда открывает меню
  #    самой панели, поэтому плазмоид из пакета убран совсем;
  # 2) служебный ярлык меню-попапа, которым пользовался плазмоид;
  # 3) кеш приложений — чтобы «виджет не найден» не висел в панели.
  rm -rf /usr/share/plasma/plasmoids/org.forest.proxyupdater
  rm -f /usr/share/applications/forest-proxy-updater-menu.desktop
  post_install "$@"
  echo "forest-proxy-updater: значка ДВА больше не будет — значок один, в стиле трея."
  echo "  Его поднимает сама программа в сеансе пользователя (служба) — стартовать вручную не нужно."
  echo "  Живые копии на момент установки сняты (см. строку «старый значок остановлен» выше)."
  echo "  Если виджет старой версии остался в панели, уберите его БЕЗ root:"
  echo "    forest-clean-desktop"
}

pre_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl disable --now forest-proxy-updater.service >/dev/null 2>&1 || true
    systemctl disable --now forest-proxy-updater.timer   >/dev/null 2>&1 || true
  fi
}

post_remove() {
  [ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
  rm -rf /var/lib/forest-proxy-updater
}
